{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure (VS2022)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build-vs2022",
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-vs2022",
        "--config",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ],
      "dependsOn": "CMake Configure (VS2022)"
    },
    {
      "label": "CMake Build Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-vs2022",
        "--config",
        "Release"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ],
      "dependsOn": "CMake Configure (VS2022)"
    },
    {
      "label": "Run Debug",
      "type": "shell",
      "command": "${workspaceFolder}\\build-vs2022\\Debug\\MagisterRenderer.exe",
      "dependsOn": "CMake Build Debug",
      "problemMatcher": []
    },
    {
      "label": "Run Release",
      "type": "shell",
      "command": "${workspaceFolder}\\build-vs2022\\Release\\MagisterRenderer.exe",
      "dependsOn": "CMake Build Release",
      "problemMatcher": []
    }
  ]
}
